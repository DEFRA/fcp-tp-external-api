{
  "name": "fcp-tp-external-api",
  "version": "0.0.0",
  "description": "Third party external GraphQL API for the Single Front Door programme",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --watch-path=./src src/index.js",
    "dev:debug": "NODE_ENV=development node --env-file-if-exists=.env --watch --watch-path=./src --inspect src/index.js",
    "docker:build": "docker compose --profile app build",
    "docker:dev": "docker compose --profile app up",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "local": "npm run services:up && npm run dev",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "start": "NODE_ENV=production node .",
    "test": "cross-env TZ=UTC vitest run --coverage",
    "test:unit": "cross-env TZ=UTC vitest run --coverage --project unit",
    "test:integration": "cross-env TZ=UTC vitest run --coverage --project integration",
    "test:watch": "cross-env TZ=UTC vitest",
    "test:debug": "cross-env TZ=UTC vitest --inspect --no-file-parallelism"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/hapi": "2.0.2",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-secure-context": "0.4.1",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@graphql-tools/load-files": "7.0.1",
    "@graphql-tools/merge": "9.2.8",
    "@graphql-tools/schema": "10.1.5",
    "@hapi/catbox": "12.1.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/hapi": "21.4.12",
    "@hapi/wreck": "18.1.3",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "global-agent": "3.0.0",
    "graphql": "16.14.2",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "neostandard": "0.13.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "hapi-pulse": {
      "joi": "18.3.1"
    }
  }
}
