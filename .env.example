# Copy this file to .env for local development.
# Real environment variables always take precedence over this file.
# .env is gitignored — never commit it.

# Server
PORT=3001
NODE_ENV=development

# Data Access Layer (DAL)
# When running host-native the DAL container is reachable on localhost:3005.
DAL_ENDPOINT=http://localhost:3005/graphql
DAL_GATEWAY_TYPE=external
DAL_REQUEST_TIMEOUT_MS=15000

# Entra (Microsoft Azure AD) machine-to-machine credentials for calling the DAL.
# Locally the DAL container runs with DISABLE_AUTH=true and does not check our token, so set
# DAL_DISABLE_AUTH=true to skip fetching one and send a placeholder instead. In every deployed
# environment DAL_DISABLE_AUTH must be unset/false and the Entra values below must be real.
DAL_DISABLE_AUTH=true
DAL_TENANT_ID=
DAL_TOKEN_ENDPOINT=
DAL_CLIENT_ID=
DAL_CLIENT_SECRET=

# Sanitization of business and personal data before it leaves this service.
SANITIZE_DATA=true
SANITIZE_SECRET=local-sanitize-secret-change-me

# Echo a caller's own recent updates back to them, bypassing re-sanitization, so
# they can confirm a write took effect. Only meaningful while SANITIZE_DATA=true.
UPDATE_ECHO_ENABLED=true
UPDATE_ECHO_TTL_MS=900000

# Only allow callers whose Defra ID token is for a CRN in ALLOWED_CRNS (comma separated).
# Defaults to true when unset. Off locally so curl and GraphQL explorers work without a token.
RESTRICT_CRNS=false
ALLOWED_CRNS=

# GraphQL
GRAPHQL_INTROSPECTION_ENABLED=true

# Auditing. Off locally so nothing else is needed. To try it, set AUDIT_ENABLED=true and uncomment
# the block below, which starts the local AWS emulator with the audit profile.
# DAL_AUDIT_SNS_TOPIC_ARN also sends the local DAL's events to the same queue.
AUDIT_ENABLED=false
# COMPOSE_PROFILES=audit
# AUDIT_SNS_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:fcp_tp_external_api_audit
# DAL_AUDIT_SNS_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:fcp_tp_external_api_audit
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Metrics (prevent connection errors to the CloudWatch EMF agent locally)
AWS_EMF_ENVIRONMENT=Local
