# Copy this file to .env for local development.
# Real environment variables always take precedence over this file.
# .env is gitignored — never commit it.

# Server
PORT=3001
NODE_ENV=development

# Data Access Layer (DAL)
# When running host-native the DAL container is reachable on localhost:3000.
DAL_ENDPOINT=http://localhost:3000/graphql
DAL_GATEWAY_TYPE=external
DAL_REQUEST_TIMEOUT_MS=15000

# Entra (Microsoft Azure AD) machine-to-machine credentials for calling the DAL.
# The local DAL container runs with DISABLE_AUTH=true, so placeholder values are fine.
DAL_TENANT_ID=local-tenant-id
DAL_TOKEN_ENDPOINT=http://localhost:3000/local-token
DAL_CLIENT_ID=local-client-id
DAL_CLIENT_SECRET=local-client-secret

# Sanitization of business and personal data before it leaves this service.
SANITIZE_DATA=true
SANITIZE_SECRET=local-sanitize-secret-change-me

# GraphQL
GRAPHQL_INTROSPECTION_ENABLED=true

# Metrics (prevent connection errors to the CloudWatch EMF agent locally)
AWS_EMF_ENVIRONMENT=Local
